# Database Configuration (Neon Postgres)
JDBC_URL=jdbc:postgresql://your-neon-host.neon.tech:5432/your-database?sslmode=require
JDBC_USERNAME=your-neon-username
JDBC_PASSWORD=your-neon-password

# Supabase Storage Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=paperwise-files

# Application Environment (local or production)
APP_ENV=local

# Local Development Notes:
# - Copy this file to .env (not tracked by git)
# - For local dev, set APP_ENV=local and you can leave Supabase values empty - the app will use local uploads/ folder as fallback
# - For production (Render), set APP_ENV=production and all Supabase values must be configured - no local fallback allowed
