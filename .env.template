# PaperWise Environment Variables Template
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to Git!

# Database (Neon Postgres or local PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/paperwise
DB_USER=postgres
DB_PASS=password

# Supabase Storage
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your-anon-or-service-key-here
SUPABASE_BUCKET=paperwise-uploads

# Brevo Email API
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_SENDER_EMAIL=noreply@paperwise.com
BREVO_SENDER_NAME=PaperWise

# ─────────────────────────────────────────────────────────────
# How to use in local development:
# ─────────────────────────────────────────────────────────────

# Windows PowerShell:
# foreach($line in Get-Content .env.local) { if($line -match '^([^=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2], 'Process') } }

# Linux/Mac Bash:
# export $(cat .env.local | xargs)

# Then start Tomcat with these environment variables
